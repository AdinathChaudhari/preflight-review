{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "NEEDS_REVIEW",
              "APPROVED"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false
}
